[Unit]
Description=Re-establish adb reverse for Android Stream Desk on USB (re)connect
# Started on-demand by udev via SYSTEMD_WANTS — see ../udev/99-android-stream-desk.rules.
# Not enabled/started any other way; StartLimit prevents a flaky USB port from
# spamming restarts if the device bounces on/off quickly.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-connect.sh
# The device may still be settling right after enumeration; a couple of
# retries is cheap insurance against a transient "device not found".
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
Environment=ADB_BIN=/usr/bin/adb
Environment=ANDROID_STREAM_DESK_PORT=8089
